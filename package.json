{
  "name": "gs_goodwe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:rede": "vite --host --port 5191 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server.js",
    "simulador": "tsx --env-file=.env.local simulador/index.ts",
    "seed": "tsx --env-file=.env.local scripts/seed-supabase.ts",
    "demo:comerciante": "tsx --env-file=.env.local scripts/demo-comerciante.ts",
    "demo:atualizar": "tsx --env-file=.env.local scripts/demo-atualizar.ts",
    "demo:fiap": "tsx --env-file=.env.local scripts/demo-fiap.ts",
    "simulador:pacote": "esbuild simulador/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=deploy/vps-simulador/simulador.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --log-level=warning",
    "validar:totem": "tsx scripts/validar-totem.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}

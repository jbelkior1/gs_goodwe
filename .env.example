# Copie para .env.local e preencha (o .env.local não vai para o git).
# Supabase → Project Settings → API Keys.

# App (público: vai no build)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# liga os botões "entrar como" no login (contas de demonstração)
VITE_MODO_DEMO=true
VITE_DEMO_SENHA=
# (opcional) endereço que os QRs e links do app usam, SÓ a origem, sem caminho. O celular não abre
# "localhost": para a apresentação, com o app aberto por `npm run dev:rede`, coloque o IP do notebook
# na rede (rode `ipconfig` e use o "Endereço IPv4"), ex.: http://192.168.0.15:5191
# Sem isto, o QR usa o endereço em que a página foi aberta. Reinicie o `npm run dev:rede` depois de mudar.
VITE_URL_PUBLICA=
# (opcional) endereço do gs_vr, a página que avalia o local por foto e projeta o Ponto W em 3D ("Avalie o seu
# local" em Seja GoodWe). Sem isto usa https://jbelkior1.github.io/gs_vr/. Para testar uma cópia local do gs_vr
# (ex.: `npx serve -l 5192` na pasta dele), use http://localhost:5192/; no celular, o IP do notebook em vez de localhost.
# O gs_vr recebe a URL e a chave publicável do Supabase acima e o endereço de volta (VITE_URL_PUBLICA ou o da página).
VITE_URL_GSVR=

# No painel do Supabase, desligue a confirmação de e-mail (Authentication → Sign In / Providers →
# Email → "Confirm email"): o cadastro entra direto, sem esperar e-mail.

# Simulador e seed (SECRETO: só na sua máquina ou no Railway)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
DEMO_SENHA=
# velocidade da simulação (10 = uma hora de recarga em 6 minutos)
SIM_ACELERACAO=10

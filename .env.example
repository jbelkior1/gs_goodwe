# Copie para .env.local e preencha (o .env.local não vai para o git).
# Supabase → Project Settings → API Keys.

# App (público: vai no build)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# liga os botões "entrar como" no login (contas de demonstração)
VITE_MODO_DEMO=true
VITE_DEMO_SENHA=

# Simulador e seed (SECRETO: só na sua máquina ou no Railway)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
DEMO_SENHA=
# velocidade da simulação (10 = uma hora de recarga em 6 minutos)
SIM_ACELERACAO=10
